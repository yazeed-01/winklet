import { Bridge } from "bridge.slint";

// Design tokens shared by every page.
export global Theme {
    out property <color> island: #000000;
    out property <color> surface: #ffffff0d;
    out property <color> surface-hover: #ffffff18;
    out property <color> stroke: #ffffff14;
    out property <color> text: #f5f5f7;
    out property <color> text-dim: #a1a1aa;
    out property <color> text-faint: #6b6b76;
    out property <color> accent: #8b7bff;
    out property <color> accent-2: #4f8dff;
    out property <brush> accent-grad: @linear-gradient(135deg, #a78bfa 0%, #6366f1 50%, #3b82f6 100%);
    out property <color> green: #34d399;
    out property <color> orange: #fb923c;
    out property <color> red: #f87171;
    out property <color> blue: #38bdf8;
    out property <color> pink: #f472b6;
    out property <string> font: "Segoe UI Variable Text";
    out property <string> font-display: "Segoe UI Variable Display";
    out property <string> icons: "Segoe Fluent Icons";
    out property <duration> spring: 460ms;
    out property <easing> spring-ease: cubic-bezier(0.32, 1.28, 0.5, 1);
    out property <easing> smooth: cubic-bezier(0.2, 0.8, 0.2, 1);
    // gear colors: N gray, 1 green, 2 blue, 3 silver, 4 yellow, 5 orange, 6 red
    public pure function gear-tint(g: int) -> color {
        return g == 1 ? #34d399 : g == 2 ? #38bdf8 : g == 3 ? #c4c4ce : g == 4 ? #fbbf24 : g == 5 ? #fb923c : g == 6 ? #ff4d4d : #8b8b96;
    }
    public pure function gear-label(g: int) -> string {
        return g == 0 ? "N" : "\{g}";
    }
}

