// Car artwork. JDM/Muscle/German are original vector art; the F1 car is CC0 by looneybits (OpenGameArt "2D Race Cars").
export global Cars {
    out property <image> jdm: @image-url("../assets/cars/jdm.svg");
    out property <image> muscle: @image-url("../assets/cars/muscle.svg");
    out property <image> german: @image-url("../assets/cars/german.svg");
    out property <image> f1: @image-url("../assets/cars/f1.png");
    out property <image> selected: Bridge.car-model == 1 ? muscle : Bridge.car-model == 2 ? german : Bridge.car-model == 3 ? f1 : jdm;
}