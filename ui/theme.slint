import { Bridge } from "bridge.slint";

// One colour theme. The island stays dark in every theme (it's a notch); a theme sets its
// base, the text tint and the accent colours. Light mode lightens only the open panel.
export struct Palette {
    name: string,
    island: color,
    surface: color,
    surface-hover: color,
    stroke: color,
    text: color,
    text-dim: color,
    text-faint: color,
    accent: color,
    accent-2: color,
    grad-a: color,     // accent gradient: start, middle, end
    grad-b: color,
    grad-c: color,
}

// Design tokens shared by every page. They follow the theme picked in Settings.
export global Theme {
    // Classic first (the default); the others come from colour palettes:
    // charcoal / forest / crimson, sage / cream / burgundy, midnight / cobalt / acid lime,
    // orchid / eggplant / signal orange, obsidian / chrome / laser red,
    // steel grey / midnight charcoal / coral, a navy glow dashboard and a graphite bank app.
    out property <[Palette]> palettes: [
        { name: "Classic", island: #000000, surface: #ffffff0d, surface-hover: #ffffff18, stroke: #ffffff14,
          text: #f5f5f7, text-dim: #a1a1aa, text-faint: #6b6b76, accent: #8b7bff, accent-2: #4f8dff,
          grad-a: #a78bfa, grad-b: #6366f1, grad-c: #3b82f6 },
        { name: "Racing Green", island: #06110c, surface: #ffffff0d, surface-hover: #ffffff17, stroke: #ffffff14,
          text: #f3efe6, text-dim: #a7ada6, text-faint: #6a736c, accent: #d93a35, accent-2: #2f7a57,
          grad-a: #ef5a4c, grad-b: #c22a26, grad-c: #a31c1b },
        { name: "Burgundy Sage", island: #140706, surface: #e8d2b50f, surface-hover: #e8d2b51c, stroke: #e8d2b51a,
          text: #f1e3cf, text-dim: #a5a79b, text-faint: #77756a, accent: #c2423a, accent-2: #a5a79b,
          grad-a: #e8d2b5, grad-b: #b8433a, grad-c: #590907 },
        { name: "Acid Lime", island: #030407, surface: #ffffff0d, surface-hover: #ffffff18, stroke: #ffffff14,
          text: #f4f6fb, text-dim: #a2a8b8, text-faint: #646a7a, accent: #d4ff24, accent-2: #3d7bff,
          grad-a: #d4ff24, grad-b: #4f8dff, grad-c: #1558c9 },
        { name: "Orchid Sunset", island: #16051d, surface: #e7b0de12, surface-hover: #e7b0de1f, stroke: #e7b0de1c,
          text: #fbeefa, text-dim: #c4a6c4, text-faint: #806582, accent: #ff6a1f, accent-2: #e7b0de,
          grad-a: #e7b0de, grad-b: #ff8a4a, grad-c: #ff5a0a },
        { name: "Chrome Laser", island: #080808, surface: #cdcbca10, surface-hover: #cdcbca1c, stroke: #cdcbca1a,
          text: #f2f1f0, text-dim: #a8a6a5, text-faint: #6b6968, accent: #ee2c26, accent-2: #cdcbca,
          grad-a: #cdcbca, grad-b: #ee2c26, grad-c: #d41514 },
        { name: "Coral Steel", island: #17191c, surface: #929da714, surface-hover: #929da722, stroke: #929da71f,
          text: #f1f3f5, text-dim: #a4adb6, text-faint: #6c747c, accent: #ff4b32, accent-2: #929da7,
          grad-a: #ff8a6b, grad-b: #ff4b32, grad-c: #e0341f },
        { name: "Aurora", island: #060a17, surface: #6aa8ff12, surface-hover: #6aa8ff1f, stroke: #6aa8ff1f,
          text: #eef3ff, text-dim: #9fabc6, text-faint: #626e8a, accent: #4f8dff, accent-2: #f08a4b,
          grad-a: #7fb2ff, grad-b: #4f8dff, grad-c: #2e5bff },
        { name: "Graphite", island: #0c0c0e, surface: #ffffff0f, surface-hover: #ffffff1a, stroke: #ffffff17,
          text: #f5f5f7, text-dim: #a3a3ab, text-faint: #67676f, accent: #3b7bff, accent-2: #8a8a94,
          grad-a: #5b93ff, grad-b: #3b7bff, grad-c: #2563eb },
    ];
    out property <Palette> p: palettes[max(0, min(palettes.length - 1, Bridge.theme))];
    // Light mode dresses the open panel in warm paper tones with soft, low-contrast ink: easy
    // on the eyes, never glaring white. The pill stays dark (it's a notch, and the eyes glow).
    out property <bool> light: Bridge.light-mode && Bridge.expanded;
    out property <color> ink: light ? #3b3226 : #ffffff;
    out property <color> island: light ? #e3ddd1 : p.island;
    out property <color> surface: light ? #3b32260f : p.surface;
    out property <color> surface-hover: light ? #3b32261c : p.surface-hover;
    out property <color> stroke: light ? #3b32261a : p.stroke;
    out property <color> text: light ? #2e2923 : p.text;
    out property <color> text-dim: light ? #615a50 : p.text-dim;
    out property <color> text-faint: light ? #8c8478 : p.text-faint;
    // menus, toasts and tooltips that float over the panel
    out property <color> popup: light ? #eeeae1 : #1c1c22;
    // accents deepen a little on light so they keep their contrast
    out property <color> accent: light ? p.accent.darker(0.3) : p.accent;
    out property <color> accent-2: light ? p.accent-2.darker(0.3) : p.accent-2;
    out property <brush> accent-grad: @linear-gradient(135deg, p.grad-a 0%, p.grad-b 50%, p.grad-c 100%);
    out property <color> green: light ? #1f9466 : #34d399;
    out property <color> orange: light ? #cc6a1d : #fb923c;
    out property <color> red: light ? #cf4545 : #f87171;
    out property <color> blue: light ? #1f86bd : #38bdf8;
    out property <color> pink: light ? #c8447f : #f472b6;
    // a see-through wash of the text colour: white on dark, warm ink on light
    public pure function wash(a: float) -> color {
        return ink.with-alpha(a);
    }
    out property <string> font: "Segoe UI Variable Text";
    out property <string> font-display: "Segoe UI Variable Display";
    out property <string> icons: "Segoe Fluent Icons";
    out property <duration> spring: 460ms;
    out property <easing> spring-ease: cubic-bezier(0.32, 1.28, 0.5, 1);
    out property <easing> smooth: cubic-bezier(0.2, 0.8, 0.2, 1);
    // gear colors: N gray, 1 green, 2 blue, 3 silver, 4 yellow, 5 orange, 6 red
    public pure function gear-tint(g: int) -> color {
        return g == 1 ? #34d399 : g == 2 ? #38bdf8 : g == 3 ? #c4c4ce : g == 4 ? #fbbf24 : g == 5 ? #fb923c : g == 6 ? #ff4d4d : #8b8b96;
    }
    public pure function gear-label(g: int) -> string {
        return g == 0 ? "N" : "\{g}";
    }
}

// One colour for the eyes: what they're filled with and the glow around them.
export struct EyeColor {
    name: string,
    fill: color,
    glow: color,
}

// Eye colours picked in Settings > Look. Ice is the original look; Theme follows the accent.
export global EyeTint {
    out property <[EyeColor]> colors: [
        { name: "Ice", fill: #ffffff, glow: #7cc8ff },
        { name: "Aqua", fill: #b8fbff, glow: #22d3ee },
        { name: "Mint", fill: #b4ffd8, glow: #10b981 },
        { name: "Lime", fill: #e6ff8a, glow: #84cc16 },
        { name: "Sun", fill: #ffe08a, glow: #f59e0b },
        { name: "Peach", fill: #ffc9a8, glow: #ff7a45 },
        { name: "Rose", fill: #ffb3cf, glow: #f43f5e },
        { name: "Lilac", fill: #ddd0ff, glow: #8b5cf6 },
        { name: "Sky", fill: #c2dcff, glow: #3b82f6 },
        { name: "Ember", fill: #ffb0a3, glow: #ef4444 },
        { name: "Theme", fill: Theme.accent.mix(#ffffff, 0.45), glow: Theme.accent },
    ];
    out property <EyeColor> current: colors[max(0, min(colors.length - 1, Bridge.eye-color))];
    // on the light panel the pale fills would wash out: they take the deeper glow colour
    out property <color> fill: Theme.light ? current.glow.darker(0.2) : current.fill;
    out property <color> glow: current.glow;
}

// One tab of the panel.
export struct TabDef {
    index: int,       // Bridge.tab value
    name: string,
    icon: string,     // "" = the water drop
}

// The tabs in the order of the bar (Settings always stays in the bar).
export global TabList {
    out property <[TabDef]> all: [
        { index: 0, name: "Home", icon: "\u{E80F}" },
        { index: 1, name: "To-do", icon: "\u{E9D5}" },
        { index: 2, name: "Calendar", icon: "\u{E787}" },
        { index: 3, name: "Focus", icon: "\u{E916}" },
        { index: 11, name: "Drive modes", icon: "\u{E804}" },
        { index: 4, name: "Health", icon: "\u{EB51}" },
        { index: 5, name: "Water", icon: "" },
        { index: 6, name: "Alarms", icon: "\u{EA8F}" },
        { index: 7, name: "Shelf", icon: "\u{E7B8}" },
        { index: 16, name: "Clipboard", icon: "\u{E77F}" },
        { index: 8, name: "Audio", icon: "\u{E767}" },
        { index: 9, name: "Developer", icon: "\u{E943}" },
        { index: 14, name: "Deck", icon: "\u{F0E2}" },
        { index: 15, name: "Wallpaper", icon: "\u{E771}" },
        { index: 12, name: "Game", icon: "\u{E7FC}" },
        { index: 13, name: "Power", icon: "\u{E7E8}" },
        { index: 10, name: "Settings", icon: "\u{E713}" },
    ];
}

