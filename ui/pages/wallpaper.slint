// Wallpaper: your desktop picture now, and a gallery to pick the next one from: a 3D-style
// carousel (the default) or a grid.

import { Theme, Icon } from "../theme.slint";
import { Bridge, WallItem } from "../bridge.slint";
import { Label, Button, Glyph, IconButton, Segmented, Stepper, Tip } from "../widgets.slint";

// One picture in the gallery: click to put it on the desktop.
component WallThumb inherits Rectangle {
    in property <WallItem> item;
    border-radius: 12px;
    background: Theme.surface;
    clip: true;
    // waiting for the thumbnail: a soft shimmer
    if !root.item.loaded: Rectangle {
        property <bool> on;
        background: @linear-gradient(110deg, Theme.wash(0.02) 0%, Theme.wash(0.07) 50%, Theme.wash(0.02) 100%);
        opacity: on ? 1 : 0.4;
        animate opacity { duration: 700ms; easing: ease-in-out; }
        Timer { interval: 700ms; running: !root.item.loaded; triggered => { parent.on = !parent.on; } }
    }
    if root.item.loaded: Image {
        width: parent.width;
        height: parent.height;
        source: root.item.thumb;
        image-fit: cover;
        transform-scale: ta.has-hover ? 1.08 : 1;
        animate transform-scale { duration: 420ms; easing: Theme.smooth; }
    }
    // name on hover
    Rectangle {
        y: parent.height - 22px;
        height: 22px;
        background: @linear-gradient(180deg, #00000000 0%, #000000b0 100%);
        opacity: ta.has-hover ? 1 : 0;
        animate opacity { duration: 160ms; }
        Text {
            x: 7px;
            width: parent.width - 14px;
            text: root.item.name;
            font-family: Theme.font;
            font-size: 9.5px;
            font-weight: 600;
            color: white;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // on the desktop now
    if root.item.current: Rectangle {
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.accent;
        Rectangle {
            x: parent.width - 22px;
            y: 6px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.accent;
            Glyph { text: Icon.check; font-size: 8px; color: #0b0b12; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.wall-set(root.item.path); }
    }
}

// One picture in the carousel: it shrinks, dims and steps back the further it is from the
// front, stands on a glossy floor with its reflection, and comes forward when clicked.
component WallSlide inherits Rectangle {
    in property <WallItem> item;
    in property <float> d;                  // places from the front (fractional while sliding)
    in property <length> cw;                // the front picture's size
    in property <length> ch;
    in property <length> floor;             // where the pictures stand
    in property <length> mid;
    callback picked();
    property <float> ad: abs(d);
    property <float> s: max(0.42, 1 - min(ad, 3) * 0.19);
    // the first step aside is wide, the ones after it tuck in behind
    property <length> off: (min(ad, 1) * 0.6 + max(ad - 1, 0) * 0.32) * cw;
    property <bool> front: ad < 0.5;
    visible: ad < 3.4;
    width: cw * s;
    height: ch * s;
    x: mid + (d < 0 ? -off : off) - self.width / 2;
    y: floor - self.height;
    z: 10 - ad;
    opacity: 1 - min(ad, 3) * 0.2;
    // reflection on the floor: the picture flipped, fading out
    Rectangle {
        y: parent.height + 3px;
        height: parent.height * 0.32;
        border-radius: 10px * root.s;
        clip: true;
        opacity: 0.32;
        if root.item.loaded: Image {
            y: 0;
            width: parent.width;
            height: root.height;
            source: root.item.thumb;
            image-fit: cover;
            transform-scale-y: -1;
        }
        Rectangle { background: @linear-gradient(180deg, Theme.island.with-alpha(0.35) 0%, Theme.island 85%); }
    }
    card := Rectangle {
        border-radius: 12px * root.s;
        background: Theme.surface;
        clip: true;
        drop-shadow-blur: root.front ? 22px : 10px;
        drop-shadow-color: #000a;
        transform-scale: root.front && ta.has-hover ? 1.03 : 1;
        animate transform-scale { duration: 300ms; easing: Theme.smooth; }
        if !root.item.loaded: Rectangle {
            background: @linear-gradient(110deg, Theme.wash(0.02) 0%, Theme.wash(0.07) 50%, Theme.wash(0.02) 100%);
        }
        if root.item.loaded: Image {
            width: parent.width;
            height: parent.height;
            source: root.item.thumb;
            image-fit: cover;
        }
        // the ones aside sit in shade
        Rectangle { background: #000000.with-alpha(min(root.ad, 1.6) * 0.28); }
        if root.item.current: Rectangle {
            border-radius: parent.border-radius;
            border-width: 2px;
            border-color: Theme.accent;
            Rectangle {
                x: parent.width - 22px;
                y: 6px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.accent;
                Glyph { text: Icon.check; font-size: 8px; color: #0b0b12; }
            }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(); }
        }
    }
}

// The carousel: the wheel or the arrows slide through the folder, a click on a side picture
// brings it to the front, a click on the front one puts it on the desktop.
component WallCarousel inherits Rectangle {
    property <int> n: Bridge.walls.length;
    // slides smoothly between pictures
    property <float> at: Bridge.wall-focus;
    animate at { duration: 520ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> cw: min(self.width * 0.58, (self.height - 70px) * 16 / 9);
    property <length> ch: cw * 9 / 16;
    property <length> floor: (self.height - 34px - ch) / 2 + ch - 4px;
    function go(step: int) {
        Bridge.wall-focus = max(0, min(root.n - 1, Bridge.wall-focus + step));
    }
    clip: true;
    TouchArea {
        scroll-event(e) => {
            if e.delta-y + e.delta-x < 0 {
                root.go(1);
            } else if e.delta-y + e.delta-x > 0 {
                root.go(-1);
            }
            accept
        }
    }
    for w[i] in Bridge.walls: WallSlide {
        item: w;
        d: i - root.at;
        cw: root.cw;
        ch: root.ch;
        floor: root.floor;
        mid: root.width / 2;
        picked => {
            if i == Bridge.wall-focus { Bridge.wall-set(w.path); } else { Bridge.wall-focus = i; }
        }
    }
    // the front picture's name, where you are, and the arrows
    HorizontalLayout {
        y: parent.height - 30px;
        height: 30px;
        spacing: 8px;
        IconButton { y: 1px; icon: Icon.left; size: 28px; icon-size: 10px; fill: Theme.surface; tip: "Previous"; clicked => { root.go(-1); } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: Bridge.walls[Bridge.wall-focus].name;
                font-family: Theme.font;
                font-size: 11.5px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: (Bridge.walls[Bridge.wall-focus].current ? "On your desktop" : "Click it to set it") + " · " + (Bridge.wall-focus + 1) + " / " + root.n;
                font-family: Theme.font;
                font-size: 9.5px;
                color: Theme.text-faint;
                horizontal-alignment: center;
            }
        }
        IconButton { y: 1px; icon: Icon.right; size: 28px; icon-size: 10px; fill: Theme.surface; tip: "Next"; clicked => { root.go(1); } }
    }
}

// A folder to browse: Windows' wallpapers or one of yours (right-click to remove yours).
component SourceChip inherits Rectangle {
    in property <string> name;
    in property <int> index;
    property <bool> on: Bridge.wall-source == index;
    width: t.preferred-width + 30px;
    height: 26px;
    border-radius: 13px;
    background: on ? Theme.accent.with-alpha(0.22) : ta.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: on ? 1px : 0;
    border-color: Theme.accent.with-alpha(0.6);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        Glyph { text: root.index == 0 ? Icon.monitor : Icon.folder; font-size: 9.5px; color: root.on ? Theme.text : Theme.text-dim; }
        t := Text {
            text: root.name;
            font-family: Theme.font;
            font-size: 11px;
            font-weight: 600;
            color: root.on ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.wall-source-set(root.index); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up && root.index > 0 && !Bridge.dragging {
                Bridge.wall-remove-folder(root.index);
            }
        }
        changed has-hover => {
            if self.has-hover && root.index > 0 {
                Tip.text = "Right-click to remove this folder";
                Tip.ax = root.absolute-position.x;
                Tip.ay = root.absolute-position.y;
                Tip.aw = root.width;
                Tip.ah = root.height;
                Tip.shown = true;
            } else if !self.has-hover && Tip.text == "Right-click to remove this folder" {
                Tip.shown = false;
            }
        }
    }
}

export component WallpaperPage inherits Rectangle {
    HorizontalLayout {
        spacing: 16px;
        // the desktop now
        VerticalLayout {
            width: 248px;
            spacing: 8px;
            Rectangle {
                height: 140px;
                border-radius: 16px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;
                drop-shadow-blur: 14px;
                drop-shadow-color: #0008;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Bridge.wall-current;
                    image-fit: cover;
                }
                // little screen bezel feel: a dark band with the name
                Rectangle {
                    y: parent.height - 30px;
                    height: 30px;
                    background: @linear-gradient(180deg, #00000000 0%, #000000c0 100%);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 34px;
                            height: 16px;
                            border-radius: 8px;
                            background: Theme.accent;
                            Text { text: "NOW"; font-family: Theme.font; font-size: 8px; font-weight: 800; letter-spacing: 0.6px; color: #0b0b12; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Label { text: Bridge.wall-current-name; font-size: 11px; font-weight: 600; color: white; }
                    }
                }
            }
            Segmented {
                items: ["Fill", "Fit", "Stretch", "Centre", "Span"];
                value: Bridge.wall-fit;
                picked(i) => { Bridge.wall-fit-set(i); }
            }
            HorizontalLayout {
                height: 28px;
                spacing: 6px;
                Button { height: 28px; icon: Icon.refresh; text: "Shuffle"; horizontal-stretch: 1; tip: "A random picture from this folder"; clicked => { Bridge.wall-shuffle(); } }
                Button { height: 28px; icon: Icon.open-folder; text: "Open"; tip: Bridge.wall-dir; clicked => { Bridge.wall-open-folder(); } }
            }
            HorizontalLayout {
                height: 26px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Label { text: "Change every"; font-size: 12px; }
                }
                Stepper { value: Bridge.wall-every-text; step(d) => { Bridge.wall-every-adjust(d); } }
            }
        }
        // the gallery
        VerticalLayout {
            width: root.width - 248px - 16px;
            spacing: 10px;
            HorizontalLayout {
                height: 26px;
                spacing: 8px;
                Flickable {
                    horizontal-stretch: 1;
                    interactive: false;
                    content-width: chips.preferred-width;
                    chips := HorizontalLayout {
                        spacing: 6px;
                        for name[i] in Bridge.wall-sources: SourceChip { name: name; index: i; }
                        IconButton { icon: Icon.add; size: 26px; icon-size: 10px; fill: Theme.surface; tip: "Add a folder of your pictures"; clicked => { Bridge.wall-add-folder(); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // carousel or grid (the last one picked sticks)
                Rectangle {
                    width: 58px;
                    border-radius: 13px;
                    background: Theme.surface;
                    for g[i] in ["\u{E786}", "\u{F0E2}"]: Rectangle {
                        property <int> view: i == 0 ? 1 : 0;
                        x: 2px + i * 27px;
                        y: 2px;
                        width: 27px;
                        height: 22px;
                        border-radius: 11px;
                        background: Bridge.wall-view == view ? Theme.wash(0.14) : va.has-hover ? Theme.surface-hover : transparent;
                        animate background { duration: 140ms; }
                        Glyph { text: g; font-size: 10px; color: Bridge.wall-view == view ? Theme.text : Theme.text-faint; }
                        va := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Bridge.wall-view-set(view); }
                            changed has-hover => {
                                if self.has-hover {
                                    Tip.text = view == 1 ? "Carousel" : "Grid";
                                    Tip.ax = parent.absolute-position.x;
                                    Tip.ay = parent.absolute-position.y;
                                    Tip.aw = parent.width;
                                    Tip.ah = parent.height;
                                    Tip.shown = true;
                                } else {
                                    Tip.shown = false;
                                }
                            }
                        }
                    }
                }
            }
            if Bridge.wall-view == 1 && Bridge.walls.length > 0: WallCarousel { vertical-stretch: 1; }
            if Bridge.wall-view == 0 || Bridge.walls.length == 0: grid := Rectangle {
                vertical-stretch: 1;
                property <int> cols: 3;
                property <length> gap: 9px;
                property <length> tw: (self.width - (cols - 1) * gap) / cols;
                property <length> th: tw * 9 / 16;
                Flickable {
                    content-height: ceil(Bridge.walls.length / grid.cols) * (grid.th + grid.gap);
                    for w[i] in Bridge.walls: WallThumb {
                        x: mod(i, grid.cols) * (grid.tw + grid.gap);
                        y: floor(i / grid.cols) * (grid.th + grid.gap);
                        width: grid.tw;
                        height: grid.th;
                        item: w;
                    }
                }
                if Bridge.walls.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Glyph { text: Icon.monitor; font-size: 22px; color: Theme.text-faint; }
                    Label { text: "No pictures in this folder"; horizontal-alignment: center; color: Theme.text-dim; font-size: 12px; }
                    Label { text: "JPG, PNG, BMP and WebP in it and its subfolders show up here."; horizontal-alignment: center; color: Theme.text-faint; font-size: 10px; }
                }
            }
        }
    }
}
