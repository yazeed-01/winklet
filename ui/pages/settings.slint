// Settings page.

import { Theme, Icon, Cars, Palette } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Label, Button, Toggle, Stepper, Glyph, IconButton, Segmented, VolSlider } from "../widgets.slint";

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    in property <bool> value;
    in property <string> key;
    height: 30px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Label { text: title; font-size: 12px; }
        if sub != "": Label { text: sub; font-size: 10px; color: Theme.text-faint; }
    }
    Toggle {
        y: (parent.height - self.height) / 2;
        checked: value;
        toggled(v) => { Bridge.set-setting(key, v); }
    }
}

component CarPick inherits Rectangle {
    in property <int> model;
    in property <image> art;
    in property <string> name;
    property <bool> active: Bridge.car-model == model;
    height: 50px;
    border-radius: 12px;
    background: active ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: active ? 1.5px : 0;
    border-color: Theme.accent;
    animate background { duration: 140ms; }
    Image {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: parent.width - 10px;
        height: 28px;
        source: art;
        image-fit: contain;
    }
    Label {
        y: parent.height - 16px;
        width: parent.width;
        height: 14px;
        text: name;
        font-size: 9.5px;
        horizontal-alignment: center;
        color: active ? Theme.text : Theme.text-faint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.set-car-model(model); }
    }
}

// One theme in the picker: a tiny island in its colours, its swatches and name.
component ThemeCard inherits Rectangle {
    in property <Palette> pal;
    in property <int> index;
    property <bool> on: Bridge.theme == index;
    height: 62px;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: on ? 2px : 1px;
    border-color: on ? pal.accent : Theme.stroke;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        // mini island
        Rectangle {
            width: 66px;
            border-radius: 10px;
            background: pal.island;
            border-width: 1px;
            border-color: #ffffff1a;
            Rectangle {
                x: 8px;
                y: 9px;
                width: 50px;
                height: 14px;
                border-radius: 7px;
                background: @linear-gradient(90deg, pal.grad-a 0%, pal.grad-b 50%, pal.grad-c 100%);
            }
            Rectangle { x: 8px; y: 30px; width: 34px; height: 5px; border-radius: 2.5px; background: pal.text; opacity: 0.85; }
            Rectangle { x: 8px; y: 40px; width: 24px; height: 4px; border-radius: 2px; background: pal.text-dim; }
            Rectangle { x: 42px; y: 36px; width: 16px; height: 10px; border-radius: 5px; background: pal.accent; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Label { text: pal.name; font-size: 12px; font-weight: on ? 700 : 600; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for c in [pal.island, pal.accent, pal.accent-2, pal.text]: Rectangle {
                    width: 13px;
                    height: 13px;
                    border-radius: 6.5px;
                    background: c;
                    border-width: 1px;
                    border-color: #ffffff2a;
                }
            }
        }
    }
    if on: Glyph { x: parent.width - 22px; y: 6px; width: 16px; height: 16px; text: Icon.check; font-size: 10px; color: pal.accent; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { Bridge.set-theme(root.index); } }
}

// A labelled slider for a value between `lo` and `hi`, shown as a percentage.
// It applies when the drag ends: resizing the island under the pointer mid-drag would fight it.
component SliderRow inherits HorizontalLayout {
    in property <string> title;
    in property <float> lo: 0;
    in property <float> hi: 1;
    in property <float> value;
    callback released(float);
    height: 30px;
    spacing: 10px;
    Label { text: root.title; font-size: 12px; width: 84px; }
    s := VolSlider {
        y: 4px;
        horizontal-stretch: 1;
        value: (root.value - root.lo) / (root.hi - root.lo);
        tint: Theme.accent;
        released(v) => { root.released(root.lo + v * (root.hi - root.lo)); }
    }
    Label {
        text: round((root.lo + s.shown * (root.hi - root.lo)) * 100) + "%";
        width: 36px;
        horizontal-alignment: right;
        font-size: 11.5px;
        font-weight: 600;
        color: Theme.text-dim;
    }
}

export component SettingsPage inherits Rectangle {
    property <bool> reset-armed;
    init => { Bridge.theme-picking = false; }
    disarm := Timer {
        interval: 4s;
        running: false;
        triggered => { root.reset-armed = false; self.running = false; }
    }
    Segmented {
        visible: !Bridge.theme-picking;
        x: parent.width - self.width;
        y: 0;
        width: 210px;
        items: ["General", "Look", "Power"];
        value: Bridge.settings-view;
        picked(i) => { Bridge.settings-view = i; }
    }
    // ---- General: startup, clock, reminders, where it sits, your data ----
    if Bridge.settings-view == 0 && !Bridge.theme-picking: HorizontalLayout {
        y: 34px;
        height: parent.height - 34px;
        spacing: 18px;
        VerticalLayout {
            horizontal-stretch: 1;
            SettingRow { title: "Launch at startup"; key: "autostart"; value: Bridge.autostart; }
            SettingRow { title: "24-hour clock"; key: "clock24"; value: Bridge.clock-24h; }
            SettingRow { title: "Hide in fullscreen"; sub: "Games, videos, slides"; key: "fullscreen"; value: Bridge.hide-fullscreen; }
            SettingRow { title: "Game mode"; sub: "Stats pill, stays over fullscreen games"; key: "gamemode"; value: Bridge.game-mode; }
            SettingRow { title: "Water reminders"; sub: "08:00 to 22:00"; key: "water"; value: Bridge.water-reminders; }
            HorizontalLayout {
                height: 30px;
                Label { text: "Remind every"; font-size: 12px; }
                Stepper { value: Bridge.water-interval + " min"; step(d) => { Bridge.water-interval-adjust(d); } }
            }
            Rectangle { }
        }
        VerticalLayout {
            width: 262px;
            spacing: 6px;
            SettingRow { title: "Top centre at start"; sub: "Each launch puts it back there"; key: "homestart"; value: Bridge.island-home-start; }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    icon: Icon.drag-move;
                    text: "Move";
                    tip: "Pick it up, then click to drop it · docks to any screen edge, upright on the sides";
                    horizontal-stretch: 1;
                    clicked => { Bridge.island-move(); }
                }
                Button {
                    icon: Icon.reset;
                    text: "Top centre";
                    tip: "Put it back at the top centre";
                    horizontal-stretch: 1;
                    clicked => { Bridge.island-home(); }
                }
            }
            // your data: where it lives, open it, wipe it (two clicks so it can't happen by accident)
            HorizontalLayout {
                height: 30px;
                spacing: 6px;
                Label { text: "Your data"; font-size: 12px; horizontal-stretch: 1; }
                Button {
                    height: 28px;
                    icon: Icon.folder;
                    text: "Open";
                    tip: Bridge.data-dir;
                    clicked => { Bridge.data-open(); }
                }
                Button {
                    height: 28px;
                    icon: Icon.delete;
                    text: root.reset-armed ? "Sure? Click again" : "Reset all";
                    primary: root.reset-armed;
                    tint: Theme.red;
                    tip: "Deletes every to-do, drink, stat, game and setting";
                    clicked => {
                        if root.reset-armed {
                            root.reset-armed = false;
                            Bridge.data-reset();
                        } else {
                            root.reset-armed = true;
                            disarm.running = true;
                        }
                    }
                }
            }
            Rectangle { }
            Button { icon: Icon.power; text: "Quit Winklet"; primary: true; tint: Theme.red; clicked => { Bridge.quit(); } }
        }
    }
    // ---- Look: theme, size, eyes and the car show ----
    if Bridge.settings-view == 1 && !Bridge.theme-picking: HorizontalLayout {
        y: 34px;
        height: parent.height - 34px;
        spacing: 18px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            HorizontalLayout {
                height: 30px;
                spacing: 6px;
                Label { text: "Theme"; font-size: 12px; horizontal-stretch: 1; }
                Rectangle {
                    width: tl.preferred-width + 54px;
                    height: 28px;
                    border-radius: 10px;
                    background: tta.has-hover ? Theme.surface-hover : Theme.surface;
                    animate background { duration: 120ms; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        Rectangle { width: 10px; height: 10px; y: 9px; border-radius: 5px; background: Theme.accent; }
                        tl := Label { text: Theme.p.name; font-size: 11.5px; font-weight: 600; }
                        Glyph { text: Icon.right; font-size: 8px; color: Theme.text-faint; }
                    }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { Bridge.theme-picking = true; } }
                }
            }
            // the panel and the pill grow and shrink together
            SliderRow {
                title: "Size";
                lo: 0.8;
                hi: 1.4;
                value: Bridge.ui-scale;
                released(v) => { Bridge.ui-scale-set(v); }
            }
            // how much of the desktop shows through the island (the text stays solid)
            SliderRow {
                title: "Transparency";
                lo: 0;
                hi: 0.6;
                value: 1 - Bridge.island-alpha;
                released(v) => { Bridge.island-alpha-set(1 - v); }
            }
            Rectangle { }
        }
        VerticalLayout {
            width: 262px;
            spacing: 6px;
            SettingRow { title: "Lively eyes"; sub: "Look around, wink, music, zzz…"; key: "eyes"; value: Bridge.eyes-lively; }
            SettingRow { title: "Car show on open"; sub: "Drives in and drifts under the island"; key: "car"; value: Bridge.car-enabled; }
            HorizontalLayout {
                spacing: 6px;
                CarPick { model: 0; art: Cars.jdm; name: "JDM"; }
                CarPick { model: 1; art: Cars.muscle; name: "Muscle"; }
                CarPick { model: 2; art: Cars.german; name: "German"; }
                CarPick { model: 3; art: Cars.f1; name: "F1"; }
            }
            Button { icon: Icon.play; text: "Test drive"; clicked => { Bridge.car-preview(); } }
            Rectangle { }
        }
    }
    // theme picker: covers the page, changes apply right away
    if Bridge.theme-picking: Rectangle {
        TouchArea { }
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                height: 28px;
                spacing: 8px;
                IconButton { icon: Icon.left; size: 28px; icon-size: 10px; fill: Theme.surface; tip: "Back to settings"; clicked => { Bridge.theme-picking = false; } }
                Label { text: "Theme"; font-size: 14px; font-weight: 700; font-family: Theme.font-display; horizontal-stretch: 1; }
                Label { text: "Classic is the original look"; font-size: 10.5px; color: Theme.text-faint; }
            }
            grid := Rectangle {
                vertical-stretch: 1;
                property <length> cw: (self.width - 2 * 8px) / 3;
                Flickable {
                    content-height: ceil(Theme.palettes.length / 3) * 70px;
                    for pal[i] in Theme.palettes: ThemeCard {
                        pal: pal;
                        index: i;
                        x: mod(i, 3) * (grid.cw + 8px);
                        y: floor(i / 3) * 70px;
                        width: grid.cw;
                    }
                }
            }
        }
    }
}
