// Clipboard: everything you copied on the left, a preview with its own find bar on the right.

import { ListView } from "std-widgets.slint";
import { Theme, Icon } from "../theme.slint";
import { Bridge, ClipItem, ClipLine } from "../bridge.slint";
import { Label, Button, Glyph, IconButton, Segmented, SearchBox, Card, Tip } from "../widgets.slint";

global ClipLook {
    public pure function glyph(kind: string) -> string {
        return kind == "link" ? Icon.globe : kind == "files" ? Icon.folder : kind == "image" ? "\u{EB9F}" : kind == "color" ? "\u{E790}" : "\u{E8A5}";
    }
    public pure function name(kind: string) -> string {
        return kind == "link" ? "Link" : kind == "files" ? "Files" : kind == "image" ? "Image" : kind == "color" ? "Colour" : "Text";
    }
    public pure function tint(kind: string) -> color {
        return kind == "link" ? Theme.blue : kind == "files" ? Theme.orange : kind == "image" ? Theme.pink : kind == "color" ? Theme.green : Theme.accent;
    }
}

// One copy in the list: a thumbnail or kind icon, the first line and when.
component ClipRow inherits Rectangle {
    in property <ClipItem> item;
    property <bool> on: Bridge.clip-selected == item.id;
    height: 46px;
    border-radius: 11px;
    background: on ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.surface-hover : transparent;
    border-width: on ? 1px : 0;
    border-color: Theme.accent.with-alpha(0.45);
    animate background { duration: 110ms; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 9px;
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            clip: true;
            background: root.item.kind == "color" ? root.item.color : ClipLook.tint(root.item.kind).with-alpha(0.16);
            border-width: root.item.kind == "color" ? 1px : 0;
            border-color: Theme.wash(0.19);
            if root.item.has-thumb: Image { width: parent.width; height: parent.height; source: root.item.thumb; image-fit: cover; }
            if !root.item.has-thumb && root.item.kind != "color": Glyph { text: ClipLook.glyph(root.item.kind); font-size: 13px; color: ClipLook.tint(root.item.kind); }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Label { text: root.item.title; font-size: 11.5px; font-weight: root.on ? 600 : 400; }
            Label { text: root.item.meta; font-size: 9.5px; color: Theme.text-faint; }
        }
        if root.item.pinned: Glyph { width: 12px; text: "\u{E718}"; font-size: 9px; color: Theme.orange; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.clip-select(root.item.id); }
        double-clicked => { Bridge.clip-select(root.item.id); Bridge.clip-paste(); }
    }
}

// The text preview: monospace lines with line numbers; find matches are highlighted.
component TextView inherits Rectangle {
    property <length> lh: 17px;
    property <length> adv: probe.preferred-width / 10;
    // characters that fit on a line, told to Rust so it wraps the text to fit
    property <int> cols: floor((self.width - 34px - 18px) / max(1px, adv));
    changed cols => { Bridge.clip-cols(self.cols); }
    init => { Bridge.clip-cols(self.cols); }
    property <int> target: Bridge.clip-find-row;
    changed target => {
        if self.target >= 0 {
            lv.content-y = -max(0px, self.target * self.lh - lv.visible-height / 2 + self.lh / 2);
        }
    }
    probe := Text { visible: false; text: "0000000000"; font-family: "Cascadia Mono"; font-size: 11px; }
    lv := ListView {
        for line in Bridge.clip-lines: Rectangle {
            height: root.lh;
            background: line.current ? Theme.accent.with-alpha(0.10) : transparent;
            Text {
                x: 0;
                width: 28px;
                height: 100%;
                text: line.num;
                font-family: "Cascadia Mono";
                font-size: 9.5px;
                color: Theme.text-faint;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            HorizontalLayout {
                x: 36px;
                height: 100%;
                alignment: start;
                Text { text: line.pre; font-family: "Cascadia Mono"; font-size: 11px; color: Theme.text; vertical-alignment: center; }
                if line.has-hit: Rectangle {
                    width: hit.preferred-width;
                    border-radius: 3px;
                    background: line.current ? #fbbf24 : #fbbf2455;
                    hit := Text { text: line.hit; font-family: "Cascadia Mono"; font-size: 11px; color: line.current ? #111 : Theme.text; vertical-alignment: center; }
                }
                if line.has-hit: Text { text: line.post; font-family: "Cascadia Mono"; font-size: 11px; color: Theme.text; vertical-alignment: center; }
            }
        }
    }
}

export component ClipboardPage inherits Rectangle {
    property <bool> clear-armed;
    property <bool> textual: Bridge.clip-kind == "text" || Bridge.clip-kind == "link" || Bridge.clip-kind == "color";
    disarm := Timer { interval: 3s; running: false; triggered => { root.clear-armed = false; self.running = false; } }
    HorizontalLayout {
        spacing: 14px;
        // ---- the history ----
        VerticalLayout {
            width: 270px;
            spacing: 8px;
            SearchBox {
                placeholder: "Search everything you copied";
                edited(t) => { Bridge.clip-search(t); }
            }
            Segmented {
                items: ["All", "Text", "Links", "Images", "Files"];
                value: Bridge.clip-filter;
                picked(i) => { Bridge.clip-filter-set(i); }
            }
            Rectangle {
                vertical-stretch: 1;
                ListView {
                    for c in Bridge.clips: ClipRow { item: c; }
                }
                if Bridge.clips.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Glyph { text: Icon.copy; font-size: 20px; color: Theme.text-faint; }
                    Label { text: Bridge.clip-paused ? "Saving copies is paused" : "Nothing here yet"; horizontal-alignment: center; color: Theme.text-dim; font-size: 12px; }
                    Label { text: "Copy text, a picture or files and it shows up here. Ctrl+Alt+V opens this tab."; horizontal-alignment: center; color: Theme.text-faint; font-size: 10px; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                height: 24px;
                spacing: 4px;
                Label { text: Bridge.clip-count-text; font-size: 10.5px; color: Theme.text-faint; horizontal-stretch: 1; }
                IconButton {
                    icon: Bridge.clip-paused ? Icon.play : Icon.pause;
                    size: 24px;
                    icon-size: 9px;
                    fill: Bridge.clip-paused ? Theme.orange.with-alpha(0.25) : Theme.surface;
                    tint: Bridge.clip-paused ? Theme.orange : Theme.text-dim;
                    tip: Bridge.clip-paused ? "Start saving copies again" : "Pause: stop saving copies for now";
                    clicked => { Bridge.clip-pause-toggle(); }
                }
                Button {
                    height: 24px;
                    icon: Icon.delete;
                    text: root.clear-armed ? "Sure?" : "Clear";
                    primary: root.clear-armed;
                    tint: Theme.red;
                    tip: "Forget everything except pinned items";
                    clicked => {
                        if root.clear-armed { root.clear-armed = false; Bridge.clip-clear(); } else { root.clear-armed = true; disarm.running = true; }
                    }
                }
            }
        }
        // ---- the preview ----
        Card {
            horizontal-stretch: 1;
            clip: true;
            if Bridge.clip-kind == "": VerticalLayout {
                alignment: center;
                spacing: 6px;
                Glyph { text: "\u{E8A5}"; font-size: 22px; color: Theme.text-faint; }
                Label { text: "Pick something on the left to see it here"; horizontal-alignment: center; color: Theme.text-dim; font-size: 12px; }
            }
            if Bridge.clip-kind != "": VerticalLayout {
                padding: 12px;
                padding-bottom: 8px;
                spacing: 8px;
                // what it is, and what you can do with it
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    Rectangle {
                        width: kt.preferred-width + 34px;
                        height: 22px;
                        y: 3px;
                        border-radius: 11px;
                        background: ClipLook.tint(Bridge.clip-kind).with-alpha(0.18);
                        HorizontalLayout {
                            padding-left: 9px;
                            spacing: 5px;
                            Glyph { text: ClipLook.glyph(Bridge.clip-kind); font-size: 9.5px; color: ClipLook.tint(Bridge.clip-kind); }
                            kt := Text { text: ClipLook.name(Bridge.clip-kind); font-family: Theme.font; font-size: 10.5px; font-weight: 700; color: ClipLook.tint(Bridge.clip-kind); vertical-alignment: center; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Label { text: Bridge.clip-when; font-size: 10px; color: Theme.text-dim; }
                        Label { text: Bridge.clip-info; font-size: 9.5px; color: Theme.text-faint; }
                    }
                    if Bridge.clip-kind == "link": IconButton { icon: Icon.globe; size: 28px; icon-size: 11px; fill: Theme.surface; tip: "Open the link"; clicked => { Bridge.clip-open(""); } }
                    IconButton { icon: "\u{E718}"; size: 28px; icon-size: 11px; fill: Bridge.clip-pinned ? Theme.orange.with-alpha(0.25) : Theme.surface; tint: Bridge.clip-pinned ? Theme.orange : Theme.text; tip: Bridge.clip-pinned ? "Unpin" : "Pin: keep it, even after Clear"; clicked => { Bridge.clip-pin(); } }
                    IconButton { icon: Icon.delete; size: 28px; icon-size: 11px; fill: Theme.surface; tint: Theme.red; tip: "Delete"; clicked => { Bridge.clip-delete(); } }
                    Button { height: 28px; icon: Icon.copy; text: "Copy"; primary: true; tip: "Copy it again (double-click it in the list to paste it into the app you were using)"; clicked => { Bridge.clip-copy(); } }
                }
                // find in this text
                if root.textual: HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    SearchBox {
                        placeholder: "Find in this text";
                        text <=> Bridge.clip-find-query;
                        edited(t) => { Bridge.clip-find(t); }
                        accepted => { Bridge.clip-find-step(1); }
                    }
                    if Bridge.clip-find-text != "": Label { text: Bridge.clip-find-text; font-size: 10.5px; color: Bridge.clip-find-text == "No matches" ? Theme.red : Theme.text-dim; }
                    IconButton { y: 1px; icon: "\u{E70E}"; size: 28px; icon-size: 9px; fill: Theme.surface; tip: "Previous match"; clicked => { Bridge.clip-find-step(-1); } }
                    IconButton { y: 1px; icon: Icon.chevron-down; size: 28px; icon-size: 9px; fill: Theme.surface; tip: "Next match (Enter)"; clicked => { Bridge.clip-find-step(1); } }
                }
                if Bridge.clip-kind == "color": Rectangle {
                    height: 34px;
                    border-radius: 10px;
                    background: Bridge.clip-color;
                    border-width: 1px;
                    border-color: Theme.wash(0.19);
                }
                if root.textual: TextView { vertical-stretch: 1; }
                if Bridge.clip-kind == "image": Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: Theme.wash(0.03);
                    clip: true;
                    Image { width: parent.width; height: parent.height; source: Bridge.clip-image; image-fit: contain; }
                }
                if Bridge.clip-kind == "files": ListView {
                    vertical-stretch: 1;
                    for f in Bridge.clip-files: Rectangle {
                        height: 34px;
                        border-radius: 9px;
                        background: fa.has-hover ? Theme.surface-hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Glyph { width: 14px; text: Icon.file; font-size: 11px; color: Theme.orange; }
                            Label { text: f; font-size: 11px; color: Theme.text-dim; }
                        }
                        fa := TouchArea { mouse-cursor: pointer; clicked => { Bridge.clip-open(f); } }
                    }
                }
            }
        }
    }
}
