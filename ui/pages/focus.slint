// Focus (pomodoro) timer.

import { Theme, Icon } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Label, Button, Ring, Stepper } from "../widgets.slint";

export component FocusPage inherits Rectangle {
    HorizontalLayout {
        spacing: 22px;
        padding-left: 16px;
        alignment: start;
        Rectangle {
            width: 200px;
            Ring {
                width: 188px;
                height: 188px;
                progress: Bridge.focus-progress;
                thickness: 9px;
                tint: Bridge.focus-break ? Theme.green : Theme.orange;
                animate progress { duration: 900ms; easing: linear; }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: Bridge.focus-left;
                    font-family: Theme.font-display;
                    font-size: 40px;
                    font-weight: 300;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Label {
                    text: Bridge.focus-break ? "Break" : "Focus";
                    horizontal-alignment: center;
                    color: Bridge.focus-break ? Theme.green : Theme.orange;
                    font-weight: 600;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            width: 260px;
            HorizontalLayout {
                spacing: 8px;
                Button {
                    primary: true;
                    tint: Bridge.focus-break ? Theme.green : Theme.orange;
                    icon: Bridge.focus-running ? Icon.pause : Icon.play;
                    text: Bridge.focus-running ? "Pause" : Bridge.focus-active ? "Resume" : "Start";
                    horizontal-stretch: 1;
                    clicked => { Bridge.focus-toggle(); }
                }
                Button { icon: Icon.reset; tip: "Reset timer"; clicked => { Bridge.focus-reset(); } }
                Button { icon: Icon.skip; tip: "Skip to next phase"; clicked => { Bridge.focus-skip(); } }
            }
            HorizontalLayout {
                Label { text: "Focus length"; color: Theme.text-dim; font-size: 12px; }
                Stepper { value: Bridge.focus-minutes + " min"; step(d) => { Bridge.focus-adjust(d); } }
            }
            HorizontalLayout {
                Label { text: "Break length"; color: Theme.text-dim; font-size: 12px; }
                Stepper { value: Bridge.break-minutes + " min"; step(d) => { Bridge.break-adjust(d); } }
            }
            HorizontalLayout {
                spacing: 5px;
                Label { text: "Sessions today"; color: Theme.text-dim; font-size: 12px; horizontal-stretch: 1; }
                for i in 8: Rectangle {
                    width: 9px;
                    height: 9px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4.5px;
                    background: i < Bridge.focus-sessions ? Theme.orange : Theme.wash(0.1);
                }
            }
        }
    }
}
