// Shelf > Send: a basket of files for a phone or PC on the same Wi-Fi, then a QR code.
// The phone can also send files back (saved in Downloads).

import { Theme, Icon } from "../theme.slint";
import { Bridge, SendItem } from "../bridge.slint";
import { Glyph, Label, Button, IconButton, Tip } from "../widgets.slint";

component BasketRow inherits Rectangle {
    in property <SendItem> item;
    height: 36px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 10px;
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: root.item.is-dir ? #fbbf2426 : Theme.accent.with-alpha(0.15);
            Glyph { text: root.item.is-dir ? Icon.folder : Icon.file; font-size: 12px; color: root.item.is-dir ? #fbbf24 : Theme.accent; }
        }
        Label { text: root.item.name; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
        Label { text: root.item.size; font-size: 10.5px; color: Theme.text-faint; }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icon.close;
            size: 24px;
            icon-size: 8px;
            tint: Theme.text-faint;
            tip: "Remove from the basket";
            clicked => { Bridge.send-remove(root.item.index); }
        }
    }
}

export component SendView inherits Rectangle {
    // ---------------------------------------------------------------- basket
    if !Bridge.send-sharing && !Bridge.send-preparing: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            padding-right: 158px;   // room for the Shelf / Send switch
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Label { text: "Send"; font-weight: 700; font-size: 14px; font-family: Theme.font-display; }
                Label { text: "To a phone or PC on the same Wi-Fi"; font-size: 10px; color: Theme.text-faint; }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: 16px;
            border-width: Bridge.drop-hover ? 2px : Bridge.send-items.length == 0 ? 1px : 0;
            border-color: Bridge.drop-hover ? Theme.green : Theme.stroke;
            background: Bridge.drop-hover ? #34d3991a : transparent;
            animate background, border-color { duration: 160ms; }
            Flickable {
                content-height: blist.preferred-height;
                blist := VerticalLayout {
                    spacing: 1px;
                    for it in Bridge.send-items: BasketRow { item: it; }
                }
            }
            if Bridge.send-items.length == 0 || Bridge.drop-hover: VerticalLayout {
                alignment: center;
                spacing: 5px;
                Glyph { text: Icon.send; font-size: 24px; color: Bridge.drop-hover ? Theme.green : Theme.text-faint; }
                Label {
                    text: Bridge.drop-hover ? "Drop to add to the basket" : "Drag files onto the island, one by one or many at once";
                    horizontal-alignment: center;
                    color: Bridge.drop-hover ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                }
                if !Bridge.drop-hover: Label {
                    text: "Nothing to send? Show the QR code to receive files from your phone";
                    horizontal-alignment: center;
                    color: Theme.text-faint;
                    font-size: 10.5px;
                }
            }
        }
        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            Button { icon: Icon.file; text: "Files"; clicked => { Bridge.send-add(false); } }
            Button { icon: Icon.folder; text: "Folder"; clicked => { Bridge.send-add(true); } }
            Label { text: Bridge.send-total; font-size: 11px; color: Theme.text-dim; horizontal-stretch: 1; horizontal-alignment: center; }
            if Bridge.send-items.length > 0: Button { icon: Icon.delete; tip: "Empty the basket"; clicked => { Bridge.send-clear(); } }
            Button {
                primary: true;
                tint: Theme.green;
                icon: Icon.qr;
                text: Bridge.send-items.length > 0 ? "Show QR code" : "Receive from phone";
                clicked => { Bridge.send-start(); }
            }
        }
        if Bridge.send-status != "": Label { text: Bridge.send-status; font-size: 10.5px; color: Theme.red; height: 14px; }
    }

    // ---------------------------------------------------------------- QR code
    if Bridge.send-sharing || Bridge.send-preparing: HorizontalLayout {
        spacing: 16px;
        padding-top: 2px;
        Rectangle {
            width: 204px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 204px;
                    height: 204px;
                    border-radius: 18px;
                    background: Bridge.send-sharing ? white : Theme.surface;
                    animate background { duration: 300ms; }
                    if Bridge.send-sharing: Image {
                        x: 8px;
                        y: 8px;
                        width: 188px;
                        height: 188px;
                        source: Bridge.send-qr;
                        image-rendering: pixelated;
                    }
                    if Bridge.send-preparing: VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Glyph { text: Icon.qr; font-size: 26px; color: Theme.text-faint; }
                        Label { text: Bridge.send-status; font-size: 11px; color: Theme.text-dim; horizontal-alignment: center; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            padding-right: 0px;
            Rectangle { height: 24px; }   // under the Shelf / Send switch
            Label { text: "Scan with your phone camera"; font-size: 14px; font-weight: 700; font-family: Theme.font-display; }
            Label { text: "or open the link on any phone or PC on this Wi-Fi"; font-size: 10.5px; color: Theme.text-faint; }
            // the link: click to copy
            Rectangle {
                height: 30px;
                border-radius: 10px;
                background: lta.has-hover ? Theme.surface-hover : Theme.surface;
                animate background { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Glyph { text: Icon.copy; font-size: 11px; color: Theme.text-dim; }
                    Label { text: Bridge.send-url == "" ? "…" : Bridge.send-url; font-size: 11px; color: Theme.text-dim; horizontal-stretch: 1; }
                }
                lta := TouchArea { mouse-cursor: pointer; clicked => { Bridge.send-copy-link(); } }
            }
            // live status + time left
            HorizontalLayout {
                height: 18px;
                spacing: 7px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: 5px;
                    border-radius: 4px;
                    background: Theme.green;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: Theme.green;
                }
                Label { text: Bridge.send-status; font-size: 11.5px; horizontal-stretch: 1; }
                Label { text: Bridge.send-left; font-size: 11px; color: Theme.text-faint; }
            }
            Label {
                text: (Bridge.send-items.length == 0 ? "Receiving only" : "Sharing " + Bridge.send-total) + " · add more and they show up on the phone";
                font-size: 10.5px;
                color: Theme.text-faint;
            }
            Label {
                text: "Both devices must be on the same Wi-Fi" + (Bridge.send-ip != "" ? " (this PC: " + Bridge.send-ip + ")" : "");
                font-size: 10.5px;
                color: Theme.text-faint;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                Button { icon: Icon.add; text: "Add files"; clicked => { Bridge.send-add(false); } }
                Button { icon: Icon.download; text: "Downloads"; tip: "Files from the phone are saved here"; clicked => { Bridge.send-open-inbox(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { icon: Icon.close; text: "Stop"; tip: "Close the link"; clicked => { Bridge.send-stop(); } }
            }
        }
    }
}
